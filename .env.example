# Exact browser origin for production and direct server startup. HTTPS is required in production.
# The development wrapper derives this from --host and --port.
APP_URL=http://localhost:3000
# Generate your own value: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Applies to newly created invitations for organizations (1–365 days).
INVITATION_EXPIRY_DAYS=7

# PostgreSQL when provided; otherwise a local persistent PGlite database.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# App-wide private S3 attachment bucket. Leave empty to disable new uploads.
S3_BUCKET=
S3_REGION=ca-central-1
S3_PREFIX=portal-attachments
# Optional S3-compatible endpoint and path-style addressing (e.g. MinIO).
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Use an IAM workload role in production or standard AWS credential variables.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_FILES_PER_FORM=10
ATTACHMENT_MAX_RESPONSE_BYTES=52428800
