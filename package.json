{
  "name": "gcs-ssc-portal",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:clean": "bun run scripts/dev.ts --clean",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:postgres": "bun scripts/test-postgres.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "attachments:cleanup": "bun scripts/cleanup-attachments.ts",
    "admin:create": "bun scripts/create-administrator.ts",
    "db:seed": "bun scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@better-auth/kysely-adapter": "^1.7.5",
    "@electric-sql/pglite": "^0.5.8",
    "@gcds-core/components": "^1.6.0",
    "@gcds-core/components-vue": "^1.6.0",
    "@gcs-ssc/survey": "file:vendor/survey",
    "better-auth": "^1.7.5",
    "h3": "^1",
    "kysely": "^0.28.8",
    "kysely-pglite": "^0.6.1",
    "nanoid": "^6.0.1",
    "nuxt": "^4",
    "pg": "^8.23.0",
    "sqids": "0.3.0",
    "vue": "^3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3",
    "railway": "3.11.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "kysely": "0.28.17",
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.13"
  }
}
